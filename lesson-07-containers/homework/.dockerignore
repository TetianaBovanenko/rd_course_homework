# Task 2 — .dockerignore. Specification: ../SPEC.md → ".dockerignore".
# Exclude everything that is not needed in the build context:
# Python caches, .git, .env and secrets, and local data.

# Python cache and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Git files
.git/
.gitignore

# Documentation
*.md

# Environment files and secrets
.env
.env.*
!.env.example

# Local data and temporary files
*.csv
*.json
*.json.gz
*.parquet
*.db
*.sqlite
*.sqlite3

# Screenshots and local artifacts
screenshots/

# Virtual environments
.venv/
venv/
env/

# macOS files
.DS_Store